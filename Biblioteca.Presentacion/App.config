<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <connectionStrings>
    <!--
      Cadena de conexión a SQL Server.
      Si su servidor no se llama .\SQLEXPRESS, cambie el valor de "Data Source"
      por el nombre que aparece al conectarse en SQL Server Management Studio.
      Ejemplos: localhost   (localdb)\MSSQLLocalDB   NOMBRE-PC\SQLEXPRESS
    -->
    <add name="BibliotecaDB"
         connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=BibliotecaDB;Integrated Security=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
